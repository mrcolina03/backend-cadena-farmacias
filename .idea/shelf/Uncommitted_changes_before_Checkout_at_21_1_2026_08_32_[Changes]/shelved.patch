s:\r\n      - red_cadena_farmacia\r\n\r\n  # Frontend (React / Vite) - ADAPTADO\r\n  frontend-cadena-farmacia:\r\n    build:\r\n      context: ./FRONT/frontend-cadena-farmacias\r\n      dockerfile: Dockerfile\r\n      args:\r\n        # Importante: Vite necesita estas variables durante el 'npm run build'\r\n        VITE_API_BASE_URL: \"http://localhost:8081/api/catalogo\"\r\n        VITE_API_INVENTARIO_URL: \"http://localhost:8082/api/inventario\"\r\n        VITE_API_VENTAS_URL: \"http://localhost:8083/api/ventas\"\r\n        VITE_API_REPORTES_URL: \"http://localhost:8083/api/reportes\"\r\n    container_name: frontend-cadena-farmacia\r\n    ports:\r\n      - \"5173:80\"\r\n    environment:\r\n      VITE_API_BASE_URL: \"http://localhost:8081/api/catalogo\"\r\n      VITE_API_INVENTARIO_URL: \"http://localhost:8082/api/inventario\"\r\n      VITE_API_VENTAS_URL: \"http://localhost:8083/api/ventas\"\r\n      VITE_API_REPORTES_URL: \"http://localhost:8083/api/reportes\"\r\n    depends_on:\r\n      - ms-catalogo\r\n      - ms-inventario\r\n      - ms-ventas\r\n    networks:\r\n      - red_cadena_farmacia\r\n\r\nnetworks:\r\n  red_cadena_farmacia:\r\n    driver: bridge\r\n\r\nvolumes:\r\n  db_data:
